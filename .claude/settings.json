{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --git-common-dir)/solatree/solatree.mjs\" hook session-start"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --git-common-dir)/solatree/solatree.mjs\" hook guard-tool"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --git-common-dir)/solatree/solatree.mjs\" hook session-end",
            "timeout": 30
          }
        ]
      }
    ],
    "WorktreeCreate": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --git-common-dir)/solatree/solatree.mjs\" hook worktree-create"
          }
        ]
      }
    ],
    "WorktreeRemove": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --git-common-dir)/solatree/solatree.mjs\" hook worktree-remove"
          }
        ]
      }
    ]
  }
}
