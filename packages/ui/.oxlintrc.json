{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "error",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "group": [
              "design-canvas.jsx",
              "ios-frame.jsx",
              "preview/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "error",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Poppins|Space Grotesk|JetBrains Mono|Bebas Neue|KC Tallboy|KC Tallboy Inked|KC SimpleSans|KC SimpleSans Inked|Suti|Courier New|Courier|Oswald|Inter|IBM Plex Mono|Aero Wolves|Aero Wolves Outline|Aero Wolves Stamp))/i]",
        "message": "Font not provided by the design system (BTTCO Modern Classic). Available: Poppins (display), Space Grotesk (body), JetBrains Mono (labels), Bebas Neue (content overlay only), KC Tallboy (poster), KC SimpleSans (print), Suti (print flourish), Courier New / Courier (typewriter); legacy website faces kept for existing pages: Oswald, Inter, IBM Plex Mono; under evaluation, not approved for production: Aero Wolves, Aero Wolves Outline, Aero Wolves Stamp."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
