#!/bin/sh
# Ryozan App pre-push quality gate
# Blocks push if type check, lint, or build fails
#
# INSTALL: cp hooks/pre-push .git/hooks/pre-push && chmod +x .git/hooks/pre-push

echo ""
echo "=== Ryozan App Pre-Push Checks ==="
echo ""

echo "[1/3] Running ESLint..."
npm run lint 2>&1
if [ $? -ne 0 ]; then
  echo ""
  echo "ESLint failed. Push blocked."
  echo "Fix the errors above, then try again."
  exit 1
fi
echo "  Lint passed."

echo "[2/3] Running TypeScript type check..."
npx tsc -b --noEmit 2>&1
if [ $? -ne 0 ]; then
  echo ""
  echo "TypeScript check failed. Push blocked."
  echo "Fix the type errors above, then try again."
  exit 1
fi
echo "  Type check passed."

echo "[3/3] Running production build..."
npm run build 2>&1
if [ $? -ne 0 ]; then
  echo ""
  echo "Build failed. Push blocked."
  echo "Fix the errors above, then try again."
  exit 1
fi
echo "  Build passed."

echo ""
echo "=== All checks passed. Pushing... ==="
echo ""
