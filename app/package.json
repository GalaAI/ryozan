{
  "name": "ryozan-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:prod": "vite --mode prod-proxy",
    "build": "tsc -b && vite build",
    "check:ui-tarball": "node ../scripts/check-ui-tarball.mjs",
    "lint": "node --test booking-conversion.test.mjs booking-approval.test.mjs analytics-privacy.test.mjs src/lib/studio-settings.test.mjs src/pages/studio/studio-site.test.mjs && eslint .",
    "lint:adherence": "oxlint --config node_modules/@ryozan/ui/.oxlintrc.json src",
    "lint:adherence:src": "oxlint --config ../packages/ui/.oxlintrc.json src",
    "lint:ui": "oxlint --config node_modules/@ryozan/ui/.oxlintrc.json node_modules/@ryozan/ui/src",
    "preview": "vite preview"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
