# Leave blank in development: Vite proxies /api to the local API on
# http://localhost:18810 (override the target with VITE_API_TARGET). Set it,
# for example to http://localhost:18810, only to call the API cross-origin.
VITE_API_URL=

# Google Identity Services client ID from the active Google Cloud project.
# Register the deployed site as an authorized JavaScript origin. The API must
# verify ID tokens against this same client ID. There is no source fallback.
VITE_GOOGLE_CLIENT_ID=

# Public browser token for the parking map.
# GalaX owns the Mapbox DevKit Mod for developer workflows and token lifecycle.
# Do not use a broad developer token here.
VITE_MAPBOX_TOKEN=
