{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm ci --legacy-peer-deps",
  "ignoreCommand": null,
  "rewrites": [
    {
      "source": "/privacy",
      "has": [
        {
          "type": "host",
          "value": "app.ryozan.app"
        }
      ],
      "destination": "/index.html"
    },
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    },
    {
      "source": "/privacy-policy",
      "destination": "/privacy.html"
    },
    {
      "source": "/legal/privacy",
      "destination": "/privacy.html"
    },
    {
      "source": "/sms-terms",
      "destination": "/sms-terms.html"
    },
    {
      "source": "/sms",
      "destination": "/sms-terms.html"
    },
    {
      "source": "/legal/sms",
      "destination": "/sms-terms.html"
    },
    {
      "source": "/api/v1/bookings/",
      "destination": "https://api.ryozan.app/api/v1/bookings/"
    },
    {
      "source": "/api/v1/notifications/",
      "destination": "https://api.ryozan.app/api/v1/notifications/"
    },
    {
      "source": "/api/:path*",
      "destination": "https://api.ryozan.app/api/:path*"
    },
    {
      "source": "/health",
      "destination": "https://api.ryozan.app/health"
    },
    {
      "source": "/health/:path*",
      "destination": "https://api.ryozan.app/health/:path*"
    },
    {
      "source": "/((?!api|health|debug(?:/|$)|_next|assets|favicon|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
