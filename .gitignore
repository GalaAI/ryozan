# Scratch / one-off HTML prototypes
*.html
!app/index.html
# ?raw-imported desktop portal templates are source, not scratch prototypes.
!app/src/components/desktop-portal/*.html
!app/public/privacy.html
!app/public/sms-terms.html
!app/public/dependencies/@bttco/**/*.dc.html
# @bttco/booking-flow ships its three canon pages under their design-system names (BTTCO-059)
!app/public/dependencies/@bttco/booking-flow/**/*.html
# @bttco/booking-flow entries: the canon pages are their own documents (src/booking-host)
!app/book.html
!app/book/*.html
!app/ask.html
# @bttco/waiver-intake: canon check-in page and its document entry (src/waiver-host)
!app/public/dependencies/@bttco/waiver-intake/**/*.html
!app/checkin.html
.vercel

