# ============================================================================
# Ryozan API: local configuration. Copy to api/.env and fill NEBIUS_API_KEY.
# Every other value has a working local default.
# ============================================================================

# NVIDIA Nemotron on Nebius Token Factory (OpenAI-compatible). Required for AI.
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1

# Live web search tool for every agent (Tavily Search API, https://app.tavily.com).
# Blank hides the web_search tool.
TAVILY_API_KEY=

# Public demo installs only: self sign-up creates a verified client account with
# the chosen password and signs it in, with no verification email.
OPEN_SIGNUP_ENABLED=false
# Guards: the invite code is required, 8+ characters (blank or short keeps instant sign-up closed), the last
# open day (UTC, YYYY-MM-DD) is optional,
# and accounts created this way are capped.
OPEN_SIGNUP_CODE=
OPEN_SIGNUP_UNTIL=
OPEN_SIGNUP_MAX_ACCOUNTS=200
# Monthly Tavily searches per non-staff account.
TAVILY_MONTHLY_SEARCHES_PER_ACCOUNT=25

# Optional shared judge demo account, created or repaired at startup when both are
# set (password 12+ characters). Its password cannot be changed or reset and the
# account cannot be deleted; its monthly caps are below.
DEMO_ACCOUNT_EMAIL=
DEMO_ACCOUNT_PASSWORD=
DEMO_ACCOUNT_MONTHLY_AI_TURNS=300
DEMO_ACCOUNT_MONTHLY_SEARCHES=150
# Optional shared judge shop: the demo account owns the install, one artist's
# public catalog and sample clients are seeded, sends are capped and never reach
# sample addresses, a live Stripe key is dropped, and the shop resets daily.
DEMO_SHOP_ENABLED=false
DEMO_SHOP_DAILY_SENDS=40
DEMO_SHOP_RESET_HOUR_UTC=9
# Sample artist and sample collector logins for test agents (12+ characters).
DEMO_NPC_PASSWORD=

# Lane models (Token Factory ids). Each agent also has its own Nemotron model
# in AGENT_PROFILES; these are the tier default and the fallback chain.
# AI_PREMIUM_PRIMARY_MODEL=nvidia/nemotron-3-super-120b-a12b
# AI_PREMIUM_FALLBACK_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
# ARK_GATEWAY_UTILITY_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B

# Optional: route through an Ark Model Gateway instead of Token Factory.
# ARK_MODEL_GATEWAY_BASE_URL=http://127.0.0.1:8788/v1
# ARK_MODEL_GATEWAY_KEY=
# AI_PREMIUM_PRIMARY_MODEL=ark/nemotron-3-super

# Database (docker compose `db` service, bound to 127.0.0.1:5433).
POSTGRES_PASSWORD=change-me-local
DATABASE_URL=postgresql+asyncpg://postgres:change-me-local@localhost:5433/nexus

# Studio identity on client email, SMS, calendar and PDF output. The postal
# address prints only when set.
STUDIO_NAME=Ryozan Studio
# Prefix on new gift card codes (1-6 letters or digits). Existing codes keep redeeming.
GIFT_CARD_CODE_PREFIX=GC
# IANA zone the studio trades in. First-run setup and Studio settings can change it,
# and a value saved there wins over this one, as it does for the other studio values.
# STUDIO_TIMEZONE=America/New_York
# STUDIO_ADDRESS=
# Public studio phone shown in the app (blank hides it).
# STUDIO_PHONE=
# Shop inbox: copied on booking alerts, the Reply-To on outbound email, the
# fallback From address, the public contact address and the fallback VAPID
# subject (blank: none of these).
# SHOP_EMAIL=
# Owner's private inbox: booking alerts, and inbound mail to info@, bookings@,
# admin@, noreply@, support@ and the catch-all. Blank falls back to SHOP_EMAIL;
# with neither, inbound mail stays in the app inbox and is never forwarded.
# SHOP_OWNER_EMAIL=

# Local URLs. Hosted values are env-only.
APP_ENV=development
FRONTEND_URL=http://localhost:15310
API_PUBLIC_BASE_URL=http://localhost:18810

# Brand images in client email (tiger-mark.png, starseed-tile.png). Blank serves
# the copies in app/public/email from FRONTEND_URL.
# EMAIL_ASSET_BASE_URL=

# File uploads (Cloudflare R2). Uploads stay off until the credentials and the
# bucket name are set; R2_PUBLIC_DOMAIN is the host uploaded files are served from.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=
# R2_PUBLIC_DOMAIN=

# Shop brand pack (docs/SHOP_BRAND_PACKS.md): set both or neither.
# SHOP_PACK_BASE_URL=
# SHOP_PACK_SCOPE=

# Secrets. In development a random key is generated on first run and kept in
# api/.dev-secrets.json (gitignored). Outside development the API refuses to
# start until each one is set.
# SECRET_KEY=
# CRON_SECRET=
# DOC_REMINDER_API_KEY=
# WORKSPACE_BOT_TOKEN=

# Optional connectors. Controls for a connector stay hidden until it is set.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Separate OAuth client for Google sign-in only. Set both or neither.
# GOOGLE_SIGNIN_CLIENT_ID=
# GOOGLE_SIGNIN_CLIENT_SECRET=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# ISO 3166-1 alpha-2 country for artists' Stripe connected accounts.
# STRIPE_CONNECT_COUNTRY=US
# Plaid: sandbox or production (Plaid shut down development).
# PLAID_CLIENT_ID=
# PLAID_SECRET=
# PLAID_ENVIRONMENT=sandbox
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=

# Email: set one provider. A blank From address falls back to SHOP_EMAIL and a
# blank From name to STUDIO_NAME. The From domain must be verified with the provider.
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=
# RESEND_FROM_NAME=
# SENDGRID_API_KEY=
# SENDGRID_FROM_EMAIL=
# SENDGRID_FROM_NAME=
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM_EMAIL=
# SMTP_FROM_NAME=
# Resend webhook signing secrets. Outside development each webhook answers 503
# until its secret is set.
# RESEND_WEBHOOK_SECRET=
# RESEND_INBOUND_WEBHOOK_SECRET=
# Domain Resend receives mail on (for example in.studio.example.com). Courier
# reply addresses and artist email handles live on it; blank turns both off.
# COURIER_REPLY_DOMAIN=

# Optional Ark connection (shared Orchestra model routing and Pack bridge).
# ARK_PACK_BRIDGE_URL=
# ARK_PACK_BRIDGE_KEY=
# Ark's Matrix Mod (Eden simulations) for the Mods view, and an Ark operator token to read runs.
# ARK_MATRIX_MOD_URL=http://127.0.0.1:8788/api/eden/matrix-mod
# ARK_MATRIX_MOD_TOKEN=

# Studio policy. Workflows some studios run and others do not; all are off for
# a new install. Uncomment the ones your studio uses.
# Owner's display name for AI prompts, assistant labels and the AI reply guard.
# STUDIO_OWNER_NAME=
# Artist roster the AI agents read, one artist per line (blank: no roster in agent prompts).
# STUDIO_ARTIST_ROSTER=
# Artist slug that receives "any artist" booking requests (blank: client picks).
# DEFAULT_ARTIST_SLUG=
# Admins/founders may create bookings on behalf of an artist.
# ADMIN_BOOK_ON_BEHALF_ENABLED=false
# A staff account may act as another user in Courier (sees and sends as them).
# STAFF_PROXY_ENABLED=false
# Staff may confirm a quote proposal on the client's behalf.
# STAFF_CONFIRM_FOR_CLIENT_ENABLED=false
# Comma-separated artist booking_mode values handled by an external booking
# system; booking emails are not sent for those artists.
# EXTERNAL_BOOKING_MODES=
# Comma-separated extra inbound email local parts routed to the owner inbox.
# INBOUND_OWNER_ALIASES=
# User id that receives the cron daily debrief (blank: every founder account).
# DEBRIEF_RECIPIENT_USER_ID=
# Artist slugs in the Booky automation canary (blank: none, "*" for all).
# BOOKY_CANARY_ARTIST_SLUGS=

# Public studio settings (GET /api/v1/studio/settings). Read by the web app;
# blank values show neutral copy or hide the element.
# Weekdays as comma-separated names: sun, mon, tue, wed, thu, fri, sat.
# Days the public booking calendar shows as closed.
# BOOKING_CLOSED_WEEKDAYS=
# Days that take a request instead of a time slot; the shop confirms.
# BOOKING_REQUEST_ONLY_WEEKDAYS=
# Artist slugs the request-only days apply to (blank: every artist).
# BOOKING_REQUEST_ONLY_ARTIST_SLUGS=
# When the studio books: day=open-close in whole hours on the 24-hour clock. A
# day left out is closed. The owner can also change these in Studio settings.
# BOOKING_WORK_HOURS=wed=11-18,thu=11-18,fri=11-20,sat=11-20
# BOOKING_CONSULTATION_HOURS=tue=11-17,wed=11-17,thu=11-17,fri=11-17,sat=11-17
# Document template id for the staff "Send Waiver" action (blank: the active
# "Tattoo Consent Waiver" template).
# WAIVER_TEMPLATE_ID=
# Comma-separated image URLs used as stand-in flash previews in local dev.
# SAMPLE_FLASH_URLS=

# Public website (docs/STUDIO_WEBSITE.md). Everything here is public.
# What / shows: "product" (the Ryozan landing, default) or "studio" (this
# studio's own site: home, /our-story, /artist/<slug>, booking entry).
# PUBLIC_SITE_MODE=product
# Hostnames that get the studio site while PUBLIC_SITE_MODE=product, only for
# one install that answers on a product domain and a studio domain.
# STUDIO_SITE_HOSTS=
# One line under the studio name on the home page.
# STUDIO_TAGLINE=
# Our story text; separate paragraphs with a blank line (quote the value) or \n\n.
# STUDIO_STORY=
# Opening hours, one row per line (\n between rows).
# STUDIO_HOURS=
# https:// URLs or site paths (/media/front.jpg).
# STUDIO_HERO_IMAGE_URL=
# STUDIO_GALLERY_IMAGE_URLS=
# Comma-separated Label=https://url pairs.
# STUDIO_SOCIAL_LINKS=Instagram=https://instagram.com/your-studio

# Renamed from the product's BTTCO era. The old names (BTTCO_* and
# ELEVENLABS_BTTCO_AGENT_ID) still work but log a deprecation warning.
# ElevenLabs agent id for the business voice lane.
# ELEVENLABS_RYOZAN_AGENT_ID=
# Base URL the MCP surface calls back into (blank: this API's own port).
# RYOZAN_MCP_UPSTREAM_URL=
# RYOZAN_MCP_READ_TIMEOUT=20
# RYOZAN_MCP_CONNECT_TIMEOUT=5
# Local Postgres URL the *_pg_tests.py suites may wipe (unset: they skip).
# RYOZAN_TEST_DATABASE_URL=
